# ==========================================
# GSoC Navigator OS - Environment Variables
# ==========================================

# Core Application Settings
ENVIRONMENT=production
PORT=8000
SECRET_KEY=change-this-to-a-random-secret-string-in-production

# Database (Default: SQLite file inside container; or external PostgreSQL URL)
DATABASE_URL=sqlite:///./gsoc_navigator.db

# GitHub API Integration (Recommended to avoid rate limits: 5000 req/hr vs 60 req/hr)
# Pass your GitHub Personal Access Token here
GITHUB_TOKEN=

# AI Coaching & Proposal Assistant (Optional: free key from https://aistudio.google.com)
# If left blank, the platform automatically uses built-in heuristic/rule-based coaching
GEMINI_API_KEY=
LLM_PROVIDER=auto

# Background Polling Interval in Seconds (Default: 300 = 5 minutes)
MONITORING_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
